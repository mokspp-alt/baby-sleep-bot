BOT_TOKEN=123456:ABC-токен-от-BotFather
DB_PATH=data/sleep.db
# tiny / base / small / medium — чем больше, тем точнее и тем больше памяти (small ≈ 1 ГБ RAM)
WHISPER_MODEL=small
WHISPER_DIR=data/models
# Если Telegram с сервера недоступен: http://host:port или socks5://user:pass@host:port
TELEGRAM_PROXY=
# Свободный диалог через Claude («плохо спал и проснулся в 8:20»). Без ключа — разбор по правилам.
ANTHROPIC_API_KEY=
# Прокси к API Anthropic; если пусто — используется TELEGRAM_PROXY
ANTHROPIC_PROXY=
