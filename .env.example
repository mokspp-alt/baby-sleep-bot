BOT_TOKEN=123456:ABC-токен-от-BotFather
DB_PATH=data/sleep.db
# tiny / base / small / medium — чем больше, тем точнее и тем больше памяти (small ≈ 1 ГБ RAM)
WHISPER_MODEL=small
WHISPER_DIR=data/models
# Если Telegram с сервера недоступен: http://host:port или socks5://user:pass@host:port
TELEGRAM_PROXY=
# Свободный диалог через Claude («плохо спал и проснулся в 8:20»). Без ключа — разбор по правилам.
ANTHROPIC_API_KEY=
# Прокси к API Anthropic; если пусто — используется TELEGRAM_PROXY
ANTHROPIC_PROXY=
# Или Claude через OpenRouter: если ключ задан, ANTHROPIC_API_KEY не используется
OPENROUTER_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5   # или claude-haiku-5-5; для OpenRouter — anthropic/claude-sonnet-5.5
# CLAUDE_EFFORT=low
# Куда писать, если Claude перестал отвечать: ID вашего чата с ботом (команда /id)
ADMIN_CHAT_ID=
# Чаты для проверки бота: бот в них отвечает, но напоминаний и утренних вопросов они не получают.
# Номера через запятую, например: -5554529018,471946185
TEST_CHAT_IDS=
